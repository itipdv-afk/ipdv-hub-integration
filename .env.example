# ============================================================
#  VARIABLES DE ENTORNO — Copia este archivo a ".env"
#  y completa tus credenciales reales.
#  ¡NUNCA subas el archivo .env a Git!
# ============================================================

# --- Planning Center Online ---
PCO_APP_ID=PEGAR_TU_APPLICATION_ID_AQUI
PCO_SECRET=PEGAR_TU_SECRET_AQUI

# --- Loyverse ---
LOYVERSE_TOKEN=PEGAR_TU_TOKEN_LOYVERSE_AQUI

# --- Webhook ---
# Se obtiene al registrar el webhook en PCO (paso 3 de las instrucciones)
WEBHOOK_SECRET=PEGAR_TU_WEBHOOK_SECRET_AQUI
WEBHOOK_SECRET_UPDATED=PEGAR_SECRET_PERSON_UPDATED

# --- Opcional ---
PCO_RUT_FIELD_NAME=RUT
DRY_RUN=false
EDAD_MINIMA=18
