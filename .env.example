# ── Planning Center Online ─────────────────────────────────────────────────────
PCO_APP_ID=tu_application_id_de_pco
PCO_SECRET=tu_secret_de_pco

# ── Loyverse ───────────────────────────────────────────────────────────────────
LOYVERSE_TOKEN=tu_token_de_loyverse

# ── Opciones de sincronización ─────────────────────────────────────────────────
PCO_RUT_FIELD_NAME=RUT
EDAD_MINIMA=18
DRY_RUN=false
DELAY_ENTRE_LLAMADAS=0.5
PCO_PAGE_SIZE=100

# ── Webhooks ───────────────────────────────────────────────────────────────────
WEBHOOK_SECRET=secret_del_webhook_de_pco
WEBHOOK_SECRET_UPDATED=

# URL pública del servidor en Railway (sin barra final)
RAILWAY_URL=https://loyverse-sync-production-1f02.up.railway.app

# ── Envío de correos (Gmail) ───────────────────────────────────────────────────
# Cuenta Gmail desde la que se enviarán los comprobantes
GMAIL_USER=tucuenta@gmail.com

# App Password de Google (16 caracteres, sin espacios)
# Cómo obtenerla:
#   1. Activa verificación en 2 pasos en tu cuenta Google
#   2. Ve a: https://myaccount.google.com/apppasswords
#   3. Crea una nueva app password con nombre "Loyverse Receipts"
#   4. Copia los 16 caracteres aquí (sin espacios)
GMAIL_APP_PASS=abcd efgh ijkl mnop

# Nombre del negocio que aparece en el correo
STORE_NAME=Mi Tienda
