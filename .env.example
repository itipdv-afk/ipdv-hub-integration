# ============================================================
#  VARIABLES DE ENTORNO — Copia este archivo a ".env"
#  y completa tus credenciales reales.
#  ¡NUNCA subas el archivo .env a Git!
# ============================================================

# --- Planning Center Online ---
# Obtener en: https://api.planningcenteronline.com/oauth/applications
# Sección "Personal Access Tokens" → crear aplicación
PCO_APP_ID=PEGAR_TU_APPLICATION_ID_AQUI
PCO_SECRET=PEGAR_TU_SECRET_AQUI

# --- Loyverse ---
# Obtener en: Back Office → Configuración → Acceso API → "+ Agregar token"
LOYVERSE_TOKEN=PEGAR_TU_TOKEN_LOYVERSE_AQUI

# --- Opcional: nombre del campo personalizado RUT en PCO ---
PCO_RUT_FIELD_NAME=RUT

# --- Comportamiento ---
# Pon "true" para probar sin escribir nada en Loyverse
DRY_RUN=false

# Edad mínima para sincronizar (default: 18)
EDAD_MINIMA=18
